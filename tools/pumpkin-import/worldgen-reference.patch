+    #[test]
+    fn dump_kitecraft_stone_air_references() {
+        let output = std::env::var_os("KITECRAFT_REFERENCE_DIR")
+            .expect("KITECRAFT_REFERENCE_DIR must be set");
+        let fixtures = [
+            (0u64, 0, 0, "noise_no_blend_no_beard_0_0.occupancy"),
+            (0, 7, 4, "noise_no_blend_no_beard_7_4.occupancy"),
+            (0, -595, 544, "noise_no_blend_no_beard_-595_544.occupancy"),
+            (
+                13579,
+                -6,
+                11,
+                "noise_no_blend_no_beard_13579_-6_11.occupancy",
+            ),
+            (
+                13579,
+                -2,
+                15,
+                "noise_no_blend_no_beard_13579_-2_15.occupancy",
+            ),
+        ];
+        for (seed, chunk_x, chunk_z, name) in fixtures {
+            let world_gen = get_world_gen(
+                Seed(seed),
+                Dimension::OVERWORLD,
+                false,
+                Vec::new(),
+                String::new(),
+            );
+            let WorldGenerator::Noise(generator) = &*world_gen else {
+                unreachable!()
+            };
+            let terrain_router = terrain_without_caves_router(generator);
+            let mut chunk = ProtoChunk::new(chunk_x, chunk_z, &world_gen);
+            chunk.stage = StagedChunkEnum::StructureReferences;
+            chunk.step_to_noise_stone_air_reference(generator, &terrain_router);
+            let mut bytes = vec![0u8; 16 * 384 * 16 / 8];
+            let mut index = 0usize;
+            for x in 0..16 {
+                for local_y in 0..384 {
+                    for z in 0..16 {
+                        if chunk.get_block_state_raw(x, local_y, z).as_u16() == 1 {
+                            bytes[index / 8] |= 1 << (index % 8);
+                        }
+                        index += 1;
+                    }
+                }
+            }
+            std::fs::write(std::path::Path::new(&output).join(name), bytes).unwrap();
+        }
+    }
